# TheTVDB v4 API Credentials (REQUIRED)
# Get your API key from https://thetvdb.com/dashboard/account/apikey
TVDB_API_KEY=your_tvdb_api_key_here
# Subscriber PIN, only if your TVDB account needs one (OPTIONAL)
# TVDB_PIN=your_tvdb_pin_here

# Base URL this service is reachable at from Sonarr (OPTIONAL)
PUBLIC_URL=http://localhost:8080

# yt-dlp download configuration (OPTIONAL)
NETRC_PATH=/config/.netrc
DOWNLOADS_DIR=/downloads

# Service Configuration (OPTIONAL)
SERVICE_PORT=8080
SERVICE_HOST=0.0.0.0

# Prowlarr/Sonarr Authentication (OPTIONAL)
# If set, callers must provide this API key when making requests
# PROWLARR_API_KEY=your_prowlarr_api_key_here

# Logging Configuration (OPTIONAL)
LOG_LEVEL=INFO

# Cache Configuration (OPTIONAL)
CACHE_TTL=300